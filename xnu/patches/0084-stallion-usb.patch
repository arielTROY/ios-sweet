+/*
+ * DWC_usb31 (stallion) take-over, replacing the plain CSFTRST of the
+ * Qualcomm path. Order and checks follow shim/usblog.c usblog_init(), which
+ * enumerated on the Mac from the same Linux-initialised state
+ * (logs/diagusb4.txt): Linux leaves the core running (DCTL 0x80f00000,
+ * DEVTEN 0xe57) with its event buffer at a SysMMU IOVA.
+ *  1. stop Linux's session (DEVTEN 0, RUN_STOP 0, wait DEVCTRLHLT), so the
+ *     core does no more DMA through the IOVA mapping;
+ *  2. HSI0 SysMMU CTRL_VM(0) bit 0 off = bypass: we DMA by physical address
+ *     (Linux: 0x25; without this: SysMMU READ PAGE FAULT);
+ *  3. port capability = device (GCTL);
+ *  4. DCTL.CSFTRST (348 us on the phone; never GCTL.CORESOFTRESET, which
+ *     would lose Linux's PHY interface setup), 50 ms settle, then put back
+ *     any of Linux's global settings the reset changed, and keep the host
+ *     disconnected >= 100 ms.
+ * The PHY, eUSB2 repeater, VBUS/session, clocks and power domain are
+ * Linux's and are not touched.
+ */
+#define GSBUSCFG0               0xc100
+#define GSBUSCFG1               0xc104
+#define GUCTL1                  0xc11c
+#define GSNPSID                 0xc120
+#define GUCTL                   0xc12c
+#define GUSB3PIPECTL0           0xc2c0
+#define GTXFIFOSIZ(n)           (0xc300 + 4 * (n))
+#define GRXFIFOSIZ0             0xc380
+#define GCTL_PRTCAP_MASK        (3u << 12)
+#define GCTL_PRTCAP_DEVICE      (2u << 12)
+#define DCTL_ULSTCHNG_MASK      (0xfu << 5)
+
+static uint64_t ud_sysmmu_pa;           /* ADT /sweet-usb sweet-sysmmu-ctrl, 0 = none */
+
+static int
+ud_dwc31_reset(void)
+{
+	static const uint32_t keep[] = {
+		GUSB2PHYCFG0, GUSB3PIPECTL0, GSBUSCFG0, GSBUSCFG1, GUCTL, GUCTL1,
+		GTXFIFOSIZ(0), GTXFIFOSIZ(1), GTXFIFOSIZ(2), GTXFIFOSIZ(3), GRXFIFOSIZ0,
+	};
+	uint32_t saved[sizeof(keep) / sizeof(keep[0])];
+	int i;
+
+	/* KMA_ZERO left dirty zero lines: write them back before the core DMAs. */
+	ud_sync(0, UD_SIZE);
+
+	uint32_t dctl = dwc_rd(DCTL);
+	printf("SWEET USB: Linux left DCFG 0x%08x DCTL 0x%08x DSTS 0x%08x DEVTEN 0x%08x GEVNTADR 0x%08x%08x\n",
+	    dwc_rd(DCFG), dctl, dwc_rd(DSTS), dwc_rd(DEVTEN), dwc_rd(GEVNTADRHI), dwc_rd(GEVNTADRLO));
+	if (dctl & DCTL_RUN_STOP) {
+		dwc_wr(DEVTEN, 0);
+		dwc_wr(DCTL, dctl & ~(DCTL_RUN_STOP | DCTL_ULSTCHNG_MASK));
+		for (i = 0; i < 500 && !(dwc_rd(DSTS) & DSTS_DEVCTRLHLT); i++) {
+			delay(1000);
+		}
+		printf("SWEET USB: run/stop cleared: %s after %d ms, DSTS 0x%08x\n",
+		    (dwc_rd(DSTS) & DSTS_DEVCTRLHLT) ? "halted" : "NOT halted", i, dwc_rd(DSTS));
+	}
+
+	if (ud_sysmmu_pa != 0) {
+		vm_offset_t mmu = ml_io_map((vm_offset_t)ud_sysmmu_pa, 4);
+		if (mmu == 0) {
+			printf("SWEET USB: SysMMU map failed\n");
+			return -1;
+		}
+		uint32_t vm0 = usb_rd(mmu, 0);
+		if (vm0 & 1) {
+			*(volatile uint32_t *)mmu = vm0 & ~1u;
+			__asm__ volatile ("dsb sy" ::: "memory");
 		}
+		printf("SWEET USB: SysMMU CTRL_VM0 @0x%llx 0x%08x -> 0x%08x (bypass)\n",
+		    ud_sysmmu_pa, vm0, usb_rd(mmu, 0));
 	}
+
+	uint32_t gctl = dwc_rd(GCTL);
+	if ((gctl & GCTL_PRTCAP_MASK) != GCTL_PRTCAP_DEVICE) {
+		dwc_wr(GCTL, (gctl & ~GCTL_PRTCAP_MASK) | GCTL_PRTCAP_DEVICE);
+		printf("SWEET USB: GCTL port capability was %u, set device: GCTL 0x%08x\n",
+		    (gctl >> 12) & 3, dwc_rd(GCTL));
+	}
+
+	for (unsigned k = 0; k < sizeof(keep) / sizeof(keep[0]); k++) {
+		saved[k] = dwc_rd(keep[k]);
+	}
+	dwc_wr(DCTL, DCTL_CSFTRST);
+	for (i = 0; i < 1000 && (dwc_rd(DCTL) & DCTL_CSFTRST); i++) {
+		delay(1000);
+	}
+	printf("SWEET USB: soft reset %s after %d ms, GCTL 0x%08x DCFG 0x%08x GUSB2PHYCFG0 0x%08x\n",
+	    (dwc_rd(DCTL) & DCTL_CSFTRST) ? "STUCK" : "done", i, dwc_rd(GCTL), dwc_rd(DCFG),
+	    dwc_rd(GUSB2PHYCFG0));
+	if (dwc_rd(DCTL) & DCTL_CSFTRST) {
+		return -1;
+	}
+	delay(50000);           /* DWC_usb31 <= 1.80a: 50 ms before touching the PHY side */
+	for (unsigned k = 0; k < sizeof(keep) / sizeof(keep[0]); k++) {
+		uint32_t now_v = dwc_rd(keep[k]);
+		if (now_v != saved[k]) {
+			printf("SWEET USB: reg 0x%x changed by reset 0x%08x -> 0x%08x: restored\n",
+			    keep[k], saved[k], now_v);
+			dwc_wr(keep[k], saved[k]);
+		}
+	}
+	delay(100000);          /* >= 100 ms disconnect seen by the host */
+	return 0;
 }
 
