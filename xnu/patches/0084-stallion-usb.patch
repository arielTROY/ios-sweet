+/*
+ * DWC_usb31 (stallion): no endpoint command while the USB2 PHY may be
+ * suspended (databook 6.3.2.5; Linux dwc3_send_gadget_ep_cmd). Linux leaves
+ * GUSB2PHYCFG0 SUSPHY|ENBLSLPM set (0x00102540), so clear them around each
+ * command and put them back, as shim/usblog.c ep_cmd() does (worked on the
+ * phone). cmd_lock: the TX path (ud.lock held) and ud_thread both issue
+ * commands, and the read-modify-write of GUSB2PHYCFG0 must not interleave.
+ */
+#define GUSB2PHYCFG0            0xc200
+#define USB2PHYCFG_SUSPHY       (1u << 6)
+#define USB2PHYCFG_ENBLSLPM     (1u << 8)
+
 static int
+ud_epcmd31(unsigned ep, uint32_t cmd, uint32_t p0, uint32_t p1, uint32_t p2)
+{
+	int rc = -1;
+	int i;
+
+	lck_mtx_lock(ud.cmd_lock);
+	uint32_t phy = dwc_rd(GUSB2PHYCFG0);
+	bool restore = (phy & (USB2PHYCFG_SUSPHY | USB2PHYCFG_ENBLSLPM)) != 0;
+	if (restore) {
+		dwc_wr(GUSB2PHYCFG0, phy & ~(USB2PHYCFG_SUSPHY | USB2PHYCFG_ENBLSLPM));
+	}
+	dwc_wr(DEPCMDPAR0(ep), p0);
+	dwc_wr(DEPCMDPAR1(ep), p1);
+	dwc_wr(DEPCMDPAR2(ep), p2);
+	dwc_wr(DEPCMD(ep), cmd | DEPCMD_CMDACT);
+	for (i = 0; i < 10000; i++) {
+		uint32_t v = dwc_rd(DEPCMD(ep));
+		if (!(v & DEPCMD_CMDACT)) {
+			uint32_t status = (v >> 12) & 0xf;
+			if (status) {
+				printf("SWEET USB: ep%u cmd 0x%x status %u\n", ep, cmd & 0xf, status);
+			} else {
+				rc = 0;
+			}
+			break;
+		}
+		delay(1);
+	}
+	if (i == 10000) {
+		printf("SWEET USB: ep%u cmd 0x%x timeout\n", ep, cmd & 0xf);
+	}
+	if (restore) {
+		dwc_wr(GUSB2PHYCFG0, phy);
+	}
+	lck_mtx_unlock(ud.cmd_lock);
+	return rc;
+}
