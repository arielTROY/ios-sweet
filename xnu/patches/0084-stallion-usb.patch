+/*
+ * Boards whose USB controller the loader describes in the ADT (stallion,
+ * Pixel 10a: tools/mkadt.py --target stallion):
+ *   /sweet-usb  reg                = <u64 phys, u64 size>  DWC3/DWC_usb31 core
+ *               sweet-sysmmu-ctrl  = <u64 phys>  optional, SysMMU CTRL_VM(0)
+ *                                    of the controller's DMA path; bit 0 is
+ *                                    cleared (bypass) before the core DMAs
+ * Sweet's ADT has no /sweet-usb node: sweet keeps the Qualcomm path above
+ * (GCC/QUSB2 probe, QSCRATCH VBUS override) unchanged.
+ * Same boot-arg as sweet, but the gadget is the default here (there is no
+ * other console channel): sweetusb=0 off, 1 register dump only, 2 (default)
+ * CDC-ECM ue0 192.168.7.2 + live log to 192.168.7.1:5140 (sweetusblog=0
+ * disables the log stream). The PHY, eUSB2 repeater, VBUS/session, clocks
+ * and power domain must already be up (XNU started from Linux).
+ * Runs once, from whichever caller comes first: sweet_usb_probe() (UFS root
+ * attached) or sweet_usb_board_start() (IOFindBSDRoot, before the root
+ * device is looked up, so it also runs on a board without UFS root).
+ */
+static bool
+sweet_usb_dt_probe(void)
+{
+	static bool done;
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	uint64_t const *mmu = NULL;
+	unsigned int size = 0, mmu_size = 0;
+
+	if (SecureDTLookupEntry(NULL, "/sweet-usb", &node) != kSuccess) {
+		return false;
+	}
+	if (done) {
+		return true;
+	}
+	done = true;
+	if (SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 2 * sizeof(uintptr_t)) {
+		printf("SWEET USB: /sweet-usb has no reg\n");
+		return true;
+	}
+	if (SecureDTGetProperty(node, "sweet-sysmmu-ctrl", (void const **)&mmu, &mmu_size) == kSuccess &&
+	    mmu_size >= sizeof(uint64_t)) {
+		ud_sysmmu_pa = mmu[0];
+	}
+	int enabled = 2;
+	PE_parse_boot_argn("sweetusb", &enabled, sizeof(enabled));
+	if (!enabled) {
+		return true;
+	}
+	vm_offset_t dwc = ml_io_map(reg[0], reg[1]);
+	if (dwc == 0) {
+		printf("SWEET USB: DWC3 map failed\n");
+		return true;
+	}
+	uint32_t id = usb_rd(dwc, GSNPSID);
+	printf("SWEET USB: /sweet-usb DWC3 @0x%lx GSNPSID 0x%08x GCTL 0x%08x GSTS 0x%08x GUSB2PHYCFG 0x%08x GUSB3PIPECTL 0x%08x\n",
+	    (unsigned long)reg[0], id, usb_rd(dwc, GCTL), usb_rd(dwc, 0xc118), usb_rd(dwc, GUSB2PHYCFG0),
+	    usb_rd(dwc, GUSB3PIPECTL0));
+	printf("SWEET USB: DWC3 DCFG 0x%08x DCTL 0x%08x DEVTEN 0x%08x DSTS 0x%08x DALEPENA 0x%08x\n",
+	    usb_rd(dwc, DCFG), usb_rd(dwc, DCTL), usb_rd(dwc, DEVTEN), usb_rd(dwc, DSTS),
+	    usb_rd(dwc, DALEPENA));
+	printf("SWEET USB: DWC3 GEVNTADR 0x%08x%08x GEVNTSIZ 0x%08x GEVNTCOUNT 0x%08x GHWPARAMS0 0x%08x\n",
+	    usb_rd(dwc, GEVNTADRHI), usb_rd(dwc, GEVNTADRLO), usb_rd(dwc, GEVNTSIZ),
+	    usb_rd(dwc, GEVNTCOUNT), usb_rd(dwc, 0xc140));
+	uint32_t hi = id >> 16;
+	if (hi != 0x5533 && hi != 0x3331 && hi != 0x3332) {
+		printf("SWEET USB: not a DWC3 (GSNPSID 0x%08x)\n", id);
+		return true;
+	}
+	if (enabled >= 2) {
+		static lck_grp_t *grp;
+		grp = lck_grp_alloc_init("sweet_usb_cmd", LCK_GRP_ATTR_NULL);
+		ud.cmd_lock = lck_mtx_alloc_init(grp, LCK_ATTR_NULL);
+		ud.dwc31 = true;
+		sweet_usb_gadget_start(dwc);
+	}
+	return true;
+}
+
+/* IOFindBSDRoot (iokit/bsddev/IOKitBSDInit.cpp): no-op without /sweet-usb. */
+void
+sweet_usb_board_start(void)
+{
+	(void)sweet_usb_dt_probe();
+}
