@@ -289,12 +307,19 @@
 		printf("SWEET UFS: refusing write of %u blocks at 0x%llx\n", count, lba);
 		return EPERM;
 	}
-	uint8_t cdb[10] = {
-		0x2a, 0,
-		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
-		0, (uint8_t)(count >> 8), (uint8_t)count, 0
-	};
-	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK, true);
+	for (uint32_t i = 0; i < count; i++) {
+		uint64_t l = lba + i;
+		uint8_t cdb[10] = {
+			0x2a, 0,
+			(uint8_t)(l >> 24), (uint8_t)(l >> 16), (uint8_t)(l >> 8), (uint8_t)l,
+			0, 0, 1, 0
+		};
+		int error = ufs_scsi_at(cdb, sizeof(cdb), UFS_BLOCK, true, i * UFS_BLOCK);
+		if (error) {
+			return error;
+		}
+	}
+	return 0;
 }
 
