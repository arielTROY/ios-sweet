+/* ------------------------------------------------------------------------ */
+/* PSCI SYSTEM_RESET */
+
+static void
+sweet_delay_ms(uint32_t ms)
+{
+	uint64_t freq = __builtin_arm_rsr64("CNTFRQ_EL0");
+	if (freq == 0) {
+		freq = 24000000;
+	}
+	uint64_t end = __builtin_arm_rsr64("CNTVCT_EL0") + freq / 1000 * ms;
+	while (__builtin_arm_rsr64("CNTVCT_EL0") < end) {
+		__asm__ volatile("yield");
+	}
+}
+
+static void
+sweet_psci_system_reset(void)
+{
+	/* SMCCC: PSCI 0.2+ SYSTEM_RESET, function id 0x84000009, no arguments. */
+	register uint64_t x0 __asm__("x0") = 0x84000009ULL;
+	__asm__ volatile("smc #0" : "+r"(x0) : :
+	    "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11",
+	    "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+}
+
+static void
+sweet_reset_now(const char *why, uint32_t delay_ms)
+{
+	if (__atomic_exchange_n(&sweet_resetting, 1, __ATOMIC_ACQ_REL)) {
+		return; /* another CPU is already resetting; let the caller spin */
+	}
+	ramlog_puts("\nSWEET: ");
+	ramlog_puts(why);
+	ramlog_puts(": PSCI SYSTEM_RESET\n");
+	__asm__ volatile("dsb sy" ::: "memory");
+	sweet_delay_ms(delay_ms);
+	sweet_psci_system_reset();
+	ramlog_puts("SWEET: PSCI SYSTEM_RESET returned\n");
+}
+
+/* panic_spin_forever / halt_all_cpus: never hang a board that asked for it. */
+void
+sweet_panic_reset(void)
+{
+	if (sweet_panic_reset_ms != 0) {
+		sweet_reset_now("panic", sweet_panic_reset_ms);
+	}
+}
+
+static void
+sweet_reset_watchdog_fire(thread_call_param_t p0 __unused, thread_call_param_t p1 __unused)
+{
+	kprintf("SWEET: reset watchdog (%u s) fired\n", sweet_reset_after_s);
+	sweet_reset_now("reset watchdog", 500);
+}
+
+/* SweetPlatformExpert::start: arm the hang watchdog (sweet-reset-after). */
+void
+sweet_reset_watchdog_start(void)
+{
+	if (sweet_reset_after_s == 0) {
+		return;
+	}
+	thread_call_t call = thread_call_allocate_with_priority(sweet_reset_watchdog_fire, NULL,
+	    THREAD_CALL_PRIORITY_HIGH);
+	uint64_t deadline;
+	clock_interval_to_deadline(sweet_reset_after_s, NSEC_PER_SEC, &deadline);
+	thread_call_enter_delayed(call, deadline);
+	kprintf("SWEET: PSCI SYSTEM_RESET in %u s (sweetreset=0 disables)\n", sweet_reset_after_s);
+}
