+/* arm_init entry, before anything else: geometry from the loader. */
+void
+sweet_early_setup(boot_args *args)
+{
+	uint64_t base = args->Video.v_baseAddr;
+	uint64_t stride = args->Video.v_rowBytes;
+	uint64_t w = args->Video.v_width, h = args->Video.v_height;
+
+	if (base == 0 || args->Video.v_depth != 32 || w < 64 || h <= EARLY_BAND_H ||
+	    stride < w * 4 || (stride & 3)) {
+		return;
+	}
+	/* Only the 32MB block start.s mapped is usable, if it mapped one. */
+	if (!sweet_early_vp_block_is(base, CACHE_ATTRINDX_WRITECOMB)) {
+		return;
+	}
+	uint64_t block_end = (base & ~(uint64_t)ARM_TT_L2_OFFMASK) + ARM_TT_L2_SIZE;
+	if (base + h * stride > block_end) {
+		h = (block_end - base) / stride;
+		if (h <= EARLY_BAND_H + EARLY_CELL_H) {
+			return;
+		}
+	}
+	early_fb_pa = base;
+	early_width = (unsigned int)w;
+	early_height = (unsigned int)h;
+	early_stride = (unsigned int)(stride / 4);
+	early_rows = (early_height - EARLY_BAND_H) / EARLY_CELL_H;
+	early_cols = early_width / EARLY_CELL_W;
+	early_fb = (volatile uint32_t *)(uintptr_t)base;
+}
