+/* ------------------------------------------------------------------------ */
+/* RAM log */
+
+static void
+ramlog_put_raw(uint8_t c)
+{
+	volatile uint32_t *hdr = (volatile uint32_t *)ramlog;
+	uint32_t start = hdr[1], size = hdr[2];
+	if (start >= ramlog_cap) {
+		start = 0;
+	}
+	ramlog[PRZ_HDR + start] = c;
+	start = (uint32_t)((start + 1) % ramlog_cap);
+	if (size < ramlog_cap) {
+		size++;
+	}
+	hdr[1] = start;
+	hdr[2] = size;
+}
+
+void
+sweet_ramlog_putc(char c)
+{
+	if (ramlog == NULL) {
+		if (early_hist_len < sizeof(early_hist)) {
+			early_hist[early_hist_len++] = c;
+		}
+		return;
+	}
+	ramlog_put_raw((uint8_t)c);
+}
+
+static void
+ramlog_puts(const char *s)
+{
+	while (*s) {
+		sweet_ramlog_putc(*s++);
+	}
+}
+
+/* Point the writer at a mapping of the zone; adopt or (re)initialize it. */
+static void
+ramlog_set_base(volatile uint8_t *base, bool replay)
+{
+	volatile uint32_t *hdr = (volatile uint32_t *)base;
+	if (hdr[0] != PRZ_SIG || hdr[1] >= ramlog_cap || hdr[2] > ramlog_cap) {
+		/* Not a zone the shim (or Linux) left: start a fresh one. */
+		hdr[0] = PRZ_SIG;
+		hdr[1] = 0;
+		hdr[2] = 0;
+	} else if (hdr[2] < ramlog_cap && hdr[1] != hdr[2]) {
+		/* The shim writes linearly with start = 0; Linux keeps start == size
+		 * until the zone wraps. Append after the shim's text. */
+		hdr[1] = hdr[2];
+	}
+	ramlog = base;
+	if (replay) {
+		ramlog_puts("\n--- SWEET XNU RAM log ---\n");
+		for (unsigned int i = 0; i < early_hist_len; i++) {
+			ramlog_put_raw((uint8_t)early_hist[i]);
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/* Bootstrap V=P L2 table: page 2 of bootstrap_pagetables (see start.s). */
+extern uint8_t bootstrap_pagetables[];
+
+static volatile uint64_t *
+sweet_early_vp_slot(uint64_t pa)
+{
+	volatile uint64_t *l2 = (volatile uint64_t *)(void *)(bootstrap_pagetables + 2 * ARM_PGBYTES);
+	return &l2[(pa & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
+}
+
+static uint64_t
+sweet_early_block_tte(uint64_t pa, unsigned int attrindx)
+{
+	return (pa & ~(uint64_t)ARM_TT_L2_OFFMASK) | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+	       ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(attrindx) |
+	       ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+}
+
+/* start.s mapped this block (same V=P L1 entry as the kernel, our TTE)? */
+static bool
+sweet_early_vp_block_is(uint64_t pa, unsigned int attrindx)
+{
+	return *sweet_early_vp_slot(pa) == sweet_early_block_tte(pa, attrindx);
+}
+
+static bool
+sweet_early_map_vp_block(uint64_t pa, boot_args *args)
+{
+	if ((pa >> ARM_TT_L1_SHIFT) != (args->topOfKernelData >> ARM_TT_L1_SHIFT)) {
+		return false;   /* another V=P L1 entry: no L2 table there */
+	}
+	volatile uint64_t *slot = sweet_early_vp_slot(pa);
+	if (*slot != ARM_TTE_EMPTY) {
+		return false;   /* RAM or the framebuffer already uses this block */
+	}
+	*slot = sweet_early_block_tte(pa, CACHE_ATTRINDX_DISABLE);
+	__asm__ volatile("dsb ish; isb" ::: "memory");
+	return true;
+}
+
+static uint32_t
+chosen_u32(const char *prop, const char *bootarg, uint32_t dflt)
+{
+	uint32_t v = dflt;
+	DTEntry chosen;
+	void const *p;
+	unsigned int size;
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) == kSuccess &&
+	    SecureDTGetProperty(chosen, prop, &p, &size) == kSuccess && size == sizeof(uint32_t)) {
+		v = *(const uint32_t *)p;
+	}
+	PE_parse_boot_argn(bootarg, &v, sizeof(v));
+	return v;
+}
+
+/* After PE_init_platform: the ADT and boot-args are readable. */
+void
+sweet_early_attach(boot_args *args)
+{
+	DTEntry entry;
+	uint64_t const *reg;
+	unsigned int size;
+
+	sweet_panic_reset_ms = chosen_u32("sweet-panic-reset", "sweetpanicreset", 0);
+	sweet_reset_after_s = chosen_u32("sweet-reset-after", "sweetreset", 0);
+
+	if (SecureDTLookupEntry(NULL, "/sweet-ramlog", &entry) != kSuccess ||
+	    SecureDTGetProperty(entry, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 2 * sizeof(uint64_t) || reg[1] <= PRZ_HDR) {
+		return;
+	}
+	uint64_t pa = reg[0], len = reg[1];
+	/* One 32MB block, VA=PA, must hold the whole zone. */
+	if ((pa & ~(uint64_t)ARM_TT_L2_OFFMASK) != ((pa + len - 1) & ~(uint64_t)ARM_TT_L2_OFFMASK)) {
+		return;
+	}
+	ramlog_pa = pa;
+	ramlog_cap = len - PRZ_HDR;
+	if (sweet_early_map_vp_block(pa, args)) {
+		ramlog_set_base((volatile uint8_t *)(uintptr_t)pa, true);
+	}
+}
